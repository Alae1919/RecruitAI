# ============================================================
# Root .env — used by docker-compose.yml (dev)
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
POSTGRES_DB=recrutai_db
POSTGRES_USER=recrutai_user
POSTGRES_PASSWORD=recrutai_pass
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis / Celery (overridden by docker-compose service names)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# CORS — comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email (Gmail SMTP — revoke and regenerate app password before use)
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password

# DeepSeek / OpenAI API key — revoke old key, generate a new one
DEEPSEEK_API_KEY=your-deepseek-api-key

# spaCy NER model path (inside the container)
SPACY_MODEL_PATH=/app/models/ner_model
