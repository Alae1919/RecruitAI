# ============================================================
# Production .env — used by docker-compose.prod.yml
# Copy to .env.prod and fill in REAL production values.
# ============================================================

# Django
DJANGO_SECRET_KEY=generate-a-strong-50+-char-random-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# PostgreSQL
POSTGRES_DB=recrutai_prod
POSTGRES_USER=recrutai_prod_user
POSTGRES_PASSWORD=strong-db-password-here

# CORS
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# Email
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password

# DeepSeek / OpenAI
DEEPSEEK_API_KEY=your-deepseek-api-key

# spaCy model path (inside container)
SPACY_MODEL_PATH=/app/models/ner_model

# Frontend build arg — set to your production API base URL
REACT_APP_BACKEND_URL=https://yourdomain.com
